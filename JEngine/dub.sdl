name "jengine"
description "Jaster Game Engine/Framework"
authors "Sealab"
copyright "Copyright © 2016, Sealab"
license "MIT"

targetType "library"
targetPath "lib"

dependency "gl3n" version="~>1.3.1"
dependency "derelict-bgfx" version="~>8.0.0"
dependency "derelict-sdl2" version="~>2.1.0"
dependency "scriptlike" version="~>0.9.6"
dependency "jlib" version="*"

// When this config is used, the tests for jengine.testing will be ran.
configuration "engine_tests" {
	versions "Engine_Tests"
}

// Win x86
copyFiles "deps/win/x86/*.dll" platform="windows-x86"
copyFiles "deps/win/tools/" platform="windows"